{
  "contentrating": "Everyone",
  "description": "A dual-mode BAP Component SDK time widget with an open landscape background in Standalone Mode.",
  "file": "index.html",
  "general": {
    "properties": {
      "timePreset": {
        "order": 0,
        "text": "Time display",
        "type": "combo",
        "value": "custom",
        "options": [
          { "value": "standard", "text": "Standard" },
          { "value": "custom", "text": "Custom" }
        ]
      },
      "schemecolor": {
        "order": 10,
        "text": "ui_browse_properties_scheme_color",
        "type": "color",
        "value": "0.55 0.82 1"
      },
      "timeFormat": {
        "order": 1,
        "text": "Time format",
        "type": "combo",
        "value": "24h",
        "condition": "timePreset.value == 'custom'",
        "options": [
          { "value": "24h", "text": "24-hour" },
          { "value": "12h", "text": "12-hour" },
          { "value": "locale", "text": "System locale" }
        ]
      },
      "showSeconds": {
        "order": 2,
        "text": "Show seconds",
        "type": "bool",
        "value": false,
        "condition": "timePreset.value == 'custom'"
      },
      "showDate": {
        "order": 3,
        "text": "Show date",
        "type": "bool",
        "value": true,
        "condition": "timePreset.value == 'custom'"
      },
      "dateStyle": {
        "order": 4,
        "text": "Date format",
        "type": "combo",
        "value": "long",
        "condition": "timePreset.value == 'custom' && showDate.value == true",
        "options": [
          { "value": "long", "text": "Long" },
          { "value": "short", "text": "Short" }
        ]
      },
      "label": {
        "order": 5,
        "text": "Widget label",
        "type": "textinput",
        "value": "BAP TIME WIDGET",
        "condition": "timePreset.value == 'custom'"
      },
      "fontScale": {
        "order": 11,
        "text": "Widget size",
        "type": "slider",
        "value": 1,
        "min": 0.75,
        "max": 1.5,
        "step": 0.05
      }
    }
  },
  "preview": "preview.jpg",
  "ratingsex": "none",
  "ratingviolence": "none",
  "tags": ["Nature", "Clock"],
  "title": "BAP Time Widget Demo",
  "type": "web",
  "version": 2,
  "visibility": "private"
}
