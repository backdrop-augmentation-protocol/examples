{
  "contentrating": "Everyone",
  "description": "A dual-mode BAP Component SDK calendar widget with an open-license landscape background in Standalone Mode.",
  "file": "index.html",
  "general": {
    "properties": {
      "calendarPreset": {
        "order": 0,
        "text": "Calendar",
        "type": "combo",
        "value": "custom",
        "options": [
          { "value": "standard", "label": "Standard" },
          { "value": "custom", "label": "Custom" }
        ]
      },
      "schemecolor": {
        "order": 11,
        "text": "ui_browse_properties_scheme_color",
        "type": "color",
        "value": "0.55 0.82 1",
        "condition": "appearancePreset.value == 'custom'"
      },
      "appearancePreset": {
        "order": 10,
        "text": "Appearance",
        "type": "combo",
        "value": "custom",
        "options": [
          { "value": "standard", "label": "Standard" },
          { "value": "custom", "label": "Custom" }
        ]
      },
      "weekStart": {
        "order": 1,
        "text": "First day of week",
        "type": "combo",
        "value": "monday",
        "condition": "calendarPreset.value == 'custom'",
        "options": [
          { "value": "monday", "label": "Monday" },
          { "value": "sunday", "label": "Sunday" }
        ]
      },
      "showAdjacentDays": {
        "order": 2,
        "text": "Show adjacent month dates",
        "type": "bool",
        "value": true,
        "condition": "calendarPreset.value == 'custom'"
      },
      "showYear": {
        "order": 3,
        "text": "Show year",
        "type": "bool",
        "value": true,
        "condition": "calendarPreset.value == 'custom'"
      },
      "calendarTitle": {
        "order": 4,
        "text": "Calendar label",
        "type": "textinput",
        "value": "BAP CALENDAR",
        "condition": "calendarPreset.value == 'custom' && showYear.value == true"
      },
      "fontScale": {
        "order": 12,
        "text": "Widget size",
        "type": "slider",
        "value": 1,
        "min": 0.75,
        "max": 1.5,
        "step": 0.05,
        "condition": "appearancePreset.value == 'custom'"
      },
      "widgetOffsetX": {
        "order": 20,
        "text": "Horizontal position",
        "type": "slider",
        "value": 0,
        "min": -50,
        "max": 50,
        "step": 0.5
      },
      "widgetOffsetY": {
        "order": 21,
        "text": "Vertical position",
        "type": "slider",
        "value": 0,
        "min": -50,
        "max": 50,
        "step": 0.5
      },
      "widgetScale": {
        "order": 22,
        "text": "Transform scale",
        "type": "slider",
        "value": 1,
        "min": 0.25,
        "max": 2,
        "step": 0.05
      },
      "widgetRotation": {
        "order": 23,
        "text": "Rotation",
        "type": "slider",
        "value": 0,
        "min": -180,
        "max": 180,
        "step": 1
      },
      "widgetOpacity": {
        "order": 24,
        "text": "Opacity",
        "type": "slider",
        "value": 1,
        "min": 0.1,
        "max": 1,
        "step": 0.01
      }
    }
  },
  "preview": "preview.png",
  "ratingsex": "none",
  "ratingviolence": "none",
  "tags": ["Nature", "Clock"],
  "title": "BAP Calendar Widget Demo",
  "type": "web",
  "version": 2,
  "visibility": "private"
}
